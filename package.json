{
  "name": "sumaiya-alvi-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:site && npm run test:rules",
    "test:site": "node --test tests/site.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-sumaiya-site \"node --test tests/rules.test.mjs\"",
    "serve": "firebase emulators:start --project demo-sumaiya-site"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.35.0"
  }
}
